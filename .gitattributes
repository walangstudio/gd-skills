# Auto detect text files and perform LF normalization
* text=auto

# Sample game assets via Git LFS (keep the repo light)
samples/**/*.png filter=lfs diff=lfs merge=lfs -text
samples/**/*.jpg filter=lfs diff=lfs merge=lfs -text
samples/**/*.wav filter=lfs diff=lfs merge=lfs -text
samples/**/*.ogg filter=lfs diff=lfs merge=lfs -text
samples/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
samples/**/*.glb filter=lfs diff=lfs merge=lfs -text
samples/**/*.fbx filter=lfs diff=lfs merge=lfs -text
samples/**/*.blend filter=lfs diff=lfs merge=lfs -text
